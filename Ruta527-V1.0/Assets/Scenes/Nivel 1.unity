    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: 'NPC: Para abrir la puerta debes adivinar este acertijo'
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "Julian: \xA1\xBFQu\xE9?!"
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "NPC: Cuatro d\xEDgitos te abrir\xE1n,\nsoy el agua que no va."
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "NPC: El cami\xF3n se fue sin m\xED,\ny en la zona dos, qued\xE9 all\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: 'NPC: Ocho familias sin beber,

        una esperanza al renacer.'
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[5]
      value: "NPC: Y en la cero grieta escondido,\nest\xE1 el PIN que fue perdido."
      objectReference: {fileID: 0}
    - target: {fileID: 8730534135622711729, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: m_LocalPosition.x
      value: 74.09
      objectReference: {fileID: 0}
    - target: {fileID: 8730534135622711729, guid: a534ac97a654fe445baa013512d05be9, type: 3}
