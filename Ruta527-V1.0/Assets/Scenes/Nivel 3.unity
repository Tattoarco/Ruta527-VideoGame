      propertyPath: dialogueLines.Array.data[1]
      value: "Julian: Todo sea por salir de este mundo y recuperar mi cami\xF3n."
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "NPC: \xBFEst\xE1s seguro de que este no es el mundo real?"
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Julian: \xA1Si!, el agua contaminada no existe hace mucho, mi equipo
        y yo nos hemos encargado de eso."
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "NPC: JAJAJAJAJA \xBFEst\xE1s seguro?\xBFNo reconoces este lugar?"
      objectReference: {fileID: 0}
