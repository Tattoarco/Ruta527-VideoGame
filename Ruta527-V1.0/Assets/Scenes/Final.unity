  dialogueText: {fileID: 154846782}
  messages:
  - '"Hola... hemos estado esperando.",'
  - "\"Debes saber que este mundo no es lo que cre\xEDas.\","
  - "\"Todo ha sido una fantas\xEDa creada en tu mente.\","
  - '"Estas botellas que recolectaste son el sustento de nuestra comunidad.",'
  - "\"Cada mes, uno es elegido para entregarlas al cami\xF3n.\","
  - " \"\xBFTienes al menos 50 botellas para ayudarnos?\""
