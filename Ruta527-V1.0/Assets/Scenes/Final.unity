    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "Julian: Ya no puedo m\xE1s, t\xF3ma esta agua, repartela sabiamente."
      objectReference: {fileID: 0}
    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "NPC: Gracias, te dar\xE9 una ayuda para m\xE1s adelante."
