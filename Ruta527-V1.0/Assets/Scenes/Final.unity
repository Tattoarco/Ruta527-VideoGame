    - target: {fileID: 5760854520557037377, guid: a534ac97a654fe445baa013512d05be9, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: 'NPC: El cielo al atardecer, el coler del oro, la sangre derramada y
